# Railway environment variables for OIML R-76 Backend
# Set these in the Railway dashboard under your service > Variables

# --- Required: provided automatically by Railway when you add a PostgreSQL plugin ---
# DATABASE_URL=postgresql://...  (auto-injected by Railway PostgreSQL plugin)

# --- Required: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))" ---
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# --- Required: set AFTER you deploy to Vercel (paste your Vercel frontend URL) ---
CORS_ALLOW_ORIGINS=https://YOUR-PROJECT.vercel.app
REPORT_VERIFY_BASE_URL=https://YOUR-PROJECT.vercel.app/verify

# --- App settings ---
ENVIRONMENT=production
REPORTS_DIR=/tmp/reports
UPLOADS_DIR=/tmp/uploads
