{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "src.api.main:app",
      "functions": {
        "src/api/main.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,scripts/**,docs/**,reports/**,uploads/**,**/__pycache__/**,**/*.db,**/*.db-*}"
        }
      }
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "rewrites": [{ "source": "/((?!assets/).*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
