# deploy/.env — TEMPLATE. Copy to deploy/.env (git-ignored) and fill in.
# NEVER commit the filled file. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Postgres superuser password (compose: db service)
POSTGRES_PASSWORD=change-me

# JWT signing key — MUST be a long random string in any real deployment
JWT_SECRET_KEY=change-me

# Public origin of the frontend (CORS allowlist + QR verify URLs)
CORS_ALLOW_ORIGINS=http://localhost:8080
REPORT_VERIFY_BASE_URL=http://localhost:8080
